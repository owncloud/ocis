auto-install-peers=true
shared-workspace-lockfile=true

# @vue/component-compiler-utils
hoist-pattern[]=sass
hoist-pattern[]=*@codemirror*
hoist-pattern[]=*@lezer*

# eslint (public so they are picked up by IDEs)
public-hoist-pattern[]=*eslint*

# Make ODS available to tests, even if the main package does not require it
public-hoist-pattern[]=@ownclouders/design-system

# The shared vitest setup file (tests/unit/config/vitest.init.ts) registers the real
# DesignSystem plugin and pinia mock-store factory for @ownclouders/web-test-helpers-core's
# injectable defaultPlugins, so it needs these resolvable from the workspace root even though
# the root package does not otherwise depend on them
public-hoist-pattern[]=@ownclouders/web-pkg
public-hoist-pattern[]=@ownclouders/web-test-helpers-core

# c.f. https://github.com/vuejs/test-utils/pull/2197
hoist-pattern[]=@vue/server-renderer

