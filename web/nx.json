{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/vitest",
      "exclude": ["vite.config.ts", "vite.config.common.ts", "vite.cern.config.ts"],
      "options": {
        "testMode": "run"
      }
    }
  ],
  "targetDefaults": {
    "test:unit": {
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": []
    }
  },
  "analytics": false
}
