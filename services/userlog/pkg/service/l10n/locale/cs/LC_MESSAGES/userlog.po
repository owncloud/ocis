msgid "Access to {resource} expired"
msgstr "Platnost přístupu k položce {resource} vypršela"

#: pkg/service/templates.go:59
msgid "Attention! The instance will be shut down and deprovisioned on {date}. Download all your data before that date as no access past that date is possible."
msgstr "Upozornění! Instance bude {date} vypnuta a zrušena. Stáhněte si všechna svá data před tímto datem, poté již přístup nebude možný."

#: pkg/service/templates.go:14
msgid "File {resource} was deleted because it violates the policies"
msgstr "Soubor {resource} byl smazán, protože porušuje zásady"

#: pkg/service/templates.go:58
msgid "Instance will be shut down and deprovisioned"
msgstr "Instance bude vypnuta a zrušena"

#: pkg/service/templates.go:38
msgid "Membership expired"
msgstr "Členství vypršelo"

#: pkg/service/templates.go:13
msgid "Policies enforced"
msgstr "Uplatnění zásad"

#: pkg/service/templates.go:23
msgid "Removed from Space"
msgstr "Odebrání z prostoru"

#: pkg/service/templates.go:43
msgid "Resource shared"
msgstr "Položka nasdílena"

#: pkg/service/templates.go:48
msgid "Resource unshared"
